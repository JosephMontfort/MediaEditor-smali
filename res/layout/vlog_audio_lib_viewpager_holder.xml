<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/import_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="@dimen/vlog_audio_lib_item_local_import_layout_height">
        <FrameLayout android:layout_gravity="center" android:id="@id/import_top_icon" android:background="@drawable/vlog_audio_lib_local_import_icon_bg" android:layout_width="@dimen/vlog_audio_lib_item_local_import_icon_width" android:layout_height="@dimen/vlog_audio_lib_item_local_import_icon_height">
            <LinearLayout android:layout_gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="fill_parent">
                <ImageView android:layout_gravity="center_vertical" android:layout_width="@dimen/vlog_audio_lib_item_local_import_image_size" android:layout_height="@dimen/vlog_audio_lib_item_local_import_image_size" android:src="@drawable/ic_vlog_audio_import" />
                <TextView android:textSize="@dimen/vlog_audio_lib_item_local_import_text_size" android:textColor="#b2ffffff" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vlog_auto_audio_import" android:fontFamily="MiSans" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent">
        <com.miui.gallery.widget.recyclerview.SimpleRecyclerView android:id="@id/recycler_view" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        <LinearLayout android:layout_gravity="center" android:orientation="vertical" android:id="@id/no_local_layout" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/vlog_audio_lib_item_local_title_text_size" android:textColor="#e5ffffff" android:gravity="center" android:id="@id/no_local_title" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/vlog_auto_audio_local_title" android:fontFamily="MiSans" />
            <TextView android:textSize="@dimen/vlog_audio_lib_item_local_desc_text_size" android:textColor="#b2ffffff" android:gravity="center" android:id="@id/no_local_desc" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vlog_audio_lib_item_local_desc_margin_top" android:text="@string/vlog_auto_audio_local_desc" android:fontFamily="MiSans" />
            <FrameLayout android:layout_gravity="center_horizontal" android:id="@id/import_bottom_icon" android:background="@drawable/vlog_audio_lib_local_import_icon_bg" android:layout_width="@dimen/vlog_audio_lib_item_local_import_icon_width" android:layout_height="@dimen/vlog_audio_lib_item_local_import_icon_height" android:layout_marginTop="@dimen/vlog_audio_lib_item_local_import_icon_margin_top">
                <LinearLayout android:layout_gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="fill_parent">
                    <ImageView android:layout_gravity="center_vertical" android:layout_width="@dimen/vlog_audio_lib_item_local_import_image_size" android:layout_height="@dimen/vlog_audio_lib_item_local_import_image_size" android:src="@drawable/ic_vlog_audio_import" />
                    <TextView android:textSize="@dimen/vlog_audio_lib_item_local_import_text_size" android:textColor="#b2ffffff" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vlog_auto_audio_import" android:fontFamily="MiSans" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>