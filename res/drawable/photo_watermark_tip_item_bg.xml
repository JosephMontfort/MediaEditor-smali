<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/photo_watermark_tip_item_selected_color" />
            <corners android:radius="@dimen/photo_watermark_tip_item_text_bg_radius" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <solid android:color="@color/photo_watermark_tip_item_unselected_color" />
            <corners android:radius="@dimen/photo_watermark_tip_item_text_bg_radius" />
        </shape>
    </item>
</selector>