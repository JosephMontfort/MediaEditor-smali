<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:height="@dimen/vlog_crop_seekbar_thumb_hot_area_size" android:width="@dimen/vlog_crop_seekbar_thumb_hot_area_size">
        <shape android:shape="rectangle">
            <size android:height="@dimen/vlog_crop_seekbar_thumb_hot_area_size" android:width="@dimen/vlog_crop_seekbar_thumb_hot_area_size" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:gravity="center" android:height="@dimen/vlog_crop_seekbar_thumb_size" android:width="@dimen/vlog_crop_seekbar_thumb_size">
        <shape android:shape="oval">
            <size android:height="@dimen/vlog_crop_seekbar_thumb_size" android:width="@dimen/vlog_crop_seekbar_thumb_size" />
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>