<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/photo_agent_recommend_chip_bg_selected" />
            <stroke android:width="@dimen/photo_agent_recommend_chip_stroke" android:color="@color/photo_agent_recommend_chip_stroke" />
            <corners android:radius="@dimen/photo_agent_recommend_chip_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/photo_agent_recommend_chip_bg" />
            <stroke android:width="@dimen/photo_agent_recommend_chip_stroke" android:color="@color/photo_agent_recommend_chip_stroke" />
            <corners android:radius="@dimen/photo_agent_recommend_chip_radius" />
        </shape>
    </item>
</selector>