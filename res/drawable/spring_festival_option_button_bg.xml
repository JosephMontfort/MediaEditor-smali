<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <shape>
            <stroke android:width="1.5dip" android:color="@color/border" />
            <corners android:radius="@dimen/corners_tiny" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/surface_toggle" />
            <corners android:radius="@dimen/corners_tiny" />
        </shape>
    </item>
</selector>